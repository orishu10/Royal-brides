# Copy to .env.local for local development.

# Postgres connection string (Neon in production)
DATABASE_URL=postgres://rb:rb@localhost:5432/royalbrides

# Public URL of the site (used in email links)
APP_URL=http://localhost:3000

# Random string, at least 32 chars. Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# Protects /api/cron/* endpoints (random string, 20+ chars). Same value as the GitHub secret CRON_SECRET.
CRON_SECRET=

# Gets an email when the server hits an error (technical maintainer, not Bracha)
MAINTAINER_EMAIL=

# --- Cloudflare Turnstile (anti-spam on the forms). Empty = no check (fine for local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email to notify about new brides / orders
ADMIN_NOTIFY_EMAIL=bracha@bjs.co.il

# --- Email (Resend). If RESEND_API_KEY is empty, emails are written to .data/emails/ instead.
RESEND_API_KEY=
EMAIL_FROM="כלות מלכות <noreply@royalbrides.co.il>"
EMAIL_REPLY_TO=bracha@bjs.co.il

# --- File storage (Cloudflare R2). If R2_BUCKET is empty, files are stored in .data/uploads/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
